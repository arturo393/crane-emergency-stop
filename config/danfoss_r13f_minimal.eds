[1800]
ParameterName=TPDO1 Communication Parameter
ObjectType=0x9
SubNumber=3

[1800sub0]
ParameterName=Highest sub-index supported
ObjectType=0x7
DataType=0x0005
AccessType=ro
DefaultValue=2
PDOMapping=0

[1800sub1]
ParameterName=COB-ID
ObjectType=0x7
DataType=0x0007
AccessType=rw
DefaultValue=$NODEID+0x180
PDOMapping=0
; COB-ID = 0x180 + Node ID

[1800sub2]
ParameterName=Transmission Type
ObjectType=0x7
DataType=0x0005
AccessType=rw
DefaultValue=255
PDOMapping=0
; 255 = Asynchronous

[1A00]
ParameterName=TPDO1 Mapping
ObjectType=0x9
SubNumber=2

[1A00sub0]
ParameterName=Number of Mapped Objects
ObjectType=0x7
DataType=0x0005
AccessType=rw
DefaultValue=1
PDOMapping=0

[1A00sub1]
ParameterName=1st Mapped Object
ObjectType=0x7
DataType=0x0007
AccessType=rw
DefaultValue=0x60410010
PDOMapping=0
; 0x6041 (Status Word) : 0x00 (subindex) : 0x10 (16 bits)

; ==============================================================================
; CiA 402 OBJECTS - Drive Profile
; ==============================================================================

[6040]
ParameterName=Controlword
ObjectType=0x7
DataType=0x0005
AccessType=rw
DefaultValue=0x0000
PDOMapping=1
; Control Word para comandos CiA 402
; Bits:
;   0: Switch On
;   1: Enable Voltage
;   2: Quick Stop
;   3: Enable Operation
;   7: Fault Reset
;   8: Halt

[6041]
ParameterName=Statusword
ObjectType=0x7
DataType=0x0005
AccessType=ro
DefaultValue=0x0000
PDOMapping=1
; Status Word - Estado del dispositivo CiA 402
; Bits:
;   0: Ready to Switch On
;   1: Switched On
;   2: Operation Enabled
;   3: Fault
;   4: Voltage Enabled
;   5: Quick Stop
;   6: Switch On Disabled

[6060]
ParameterName=Modes of Operation
ObjectType=0x7
DataType=0x0002
AccessType=rw
DefaultValue=1
PDOMapping=1
; Modos de operación:
;   1 = Profile Position Mode
;   3 = Profile Velocity Mode
;   6 = Homing Mode
;   -1 = Reserved
;   -2 = Reserved
;   -3 = Reserved

[6061]
ParameterName=Modes of Operation Display
ObjectType=0x7
DataType=0x0002
AccessType=ro
DefaultValue=1
PDOMapping=1

[6064]
ParameterName=Position Actual Value
ObjectType=0x7
DataType=0x0004
AccessType=ro
DefaultValue=0
PDOMapping=1
LowLimit=0x80000000
HighLimit=0x7FFFFFFF
; Posición actual en encoder counts o milímetros

[606C]
ParameterName=Velocity Actual Value
ObjectType=0x7
DataType=0x0004
AccessType=ro
DefaultValue=0
PDOMapping=1
LowLimit=0x80000000
HighLimit=0x7FFFFFFF
; Velocidad actual en RPM o unidades configuradas

[6081]
ParameterName=Profile Velocity
ObjectType=0x7
DataType=0x0007
AccessType=rw
DefaultValue=1000
PDOMapping=0
LowLimit=0
HighLimit=0xFFFFFFFF
; Velocidad objetivo para movimientos

; ==============================================================================
; MANUFACTURER SPECIFIC OBJECTS
; ==============================================================================

[ManufacturerObjects]
SupportedObjects=0
; Reservado para objetos específicos de Danfoss
; Rango típico: 0x2000 - 0x5FFF

; ==============================================================================
; NOTAS DE IMPLEMENTACIÓN
; ==============================================================================
;
; 1. Este EDS es MÍNIMO y solo incluye objetos esenciales
; 2. Para producción se requiere EDS oficial de Danfoss
; 3. Objetos adicionales a considerar:
;    - 0x607A: Target Position
;    - 0x60FF: Target Velocity  
;    - 0x6077: Torque Actual Value
;    - 0x6083: Profile Acceleration
;    - 0x6084: Profile Deceleration
; 4. Verificar con hardware real los valores por defecto
; 5. Consultar manual del R13 F para objetos manufacturer-specific
;
; ==============================================================================
; FIN DEL ARCHIVO EDS
; ==============================================================================

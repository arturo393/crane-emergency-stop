BaudRate_500=1
BaudRate_800=0
BaudRate_1000=0
SimpleBootUpMaster=0
SimpleBootUpSlave=1
Granularity=8
DynamicChannelsSupported=0
CompactPDO=0x00
GroupMessaging=0
Features=0
LSS_Supported=1

[DummyUsage]
Dummy0001=0
Dummy0002=0
Dummy0003=0
Dummy0004=0
Dummy0005=1
Dummy0006=1
Dummy0007=1

[Comments]
Lines=5
Line1=Electronic Data Sheet para Danfoss R13 F
Line2=Receptor radio CANopen para control de puente grua
Line3=Implementa CiA 402 - Device Profile for Drives
